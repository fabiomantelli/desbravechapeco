---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  image: ImageMetadata;
  eyebrow?: string;
  text?: string;
}
const { href, title, image, eyebrow, text } = Astro.props;
---

<article class="group relative flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl">
  <div class="aspect-[3/2] overflow-hidden bg-brand-50">
    <Image
      src={image}
      alt=""
      width={600}
      widths={[400, 600, 900]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition duration-500 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6">
    {eyebrow && <p class="eyebrow text-xs">{eyebrow}</p>}
    <h3 class="font-display text-lg font-semibold text-brand-950">
      <a href={href} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    {text && <p class="line-clamp-3 text-sm">{text}</p>}
    <span class="mt-auto pt-2 text-sm font-semibold text-brand-600" aria-hidden="true">
      Saiba mais →
    </span>
  </div>
</article>
