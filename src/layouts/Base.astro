---
import '../styles/global.css';
import { sections, sectionKeys, eventCategories } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: object;
}
const {
  title,
  description = 'Hospedagem, gastronomia, atrativos, eventos e roteiros em Chapecó, a Capital do Oeste catarinense.',
  image = '/og.jpg',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} | Desbrave Chapecó` : 'Desbrave Chapecó | Turismo na Capital do Oeste';
const canonical = new URL(Astro.url.pathname, Astro.site);

const sub = (k: keyof typeof sections) =>
  Object.entries(sections[k].categories).map(([c, label]) => ({ label, href: `/categoria/${k}/${c}/` }));
const nav = [
  { label: 'Hospedagem', href: '/hospedagem/', sub: sub('hospedagem') },
  { label: 'Gastronomia', href: '/gastronomia/', sub: sub('gastronomia') },
  { label: 'Atrativos', href: '/atrativos/', sub: sub('atrativos') },
  { label: 'Serviços', href: '/servicos/', sub: sub('servicos') },
  { label: 'Rotas', href: '/experiencias/', sub: [] },
  {
    label: 'Eventos',
    href: '/eventos/',
    sub: Object.entries(eventCategories).map(([c, label]) => ({ label, href: `/eventos/#${c}` })),
  },
  { label: 'Sobre Chapecó', href: '/sobre-chapeco/', sub: [] },
];
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#2f47c9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Desbrave Chapecó" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Native prerender of same-site links on hover: instant navigation, zero JS shipped. -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body class="bg-white font-sans text-slate-700 antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2"
    >
      Pular para o conteúdo
    </a>

    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-lg">
      <div class="wrap flex h-16 items-center justify-between gap-6">
        <a
          href="/"
          class="flex items-center gap-2 font-display text-lg font-bold text-brand-950"
          aria-label="Desbrave Chapecó, página inicial"
        >
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>
            Desbrave <span class="text-brand-600">Chapecó</span>
          </span>
        </a>

        <button popovertarget="menu" class="rounded-lg p-2 text-brand-950 lg:hidden" aria-label="Abrir menu">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>

        <nav
          id="menu"
          popover
          aria-label="Principal"
          class="ml-auto h-dvh w-80 max-w-full overflow-y-auto bg-white p-6 shadow-2xl lg:h-auto lg:shadow-none"
        >
          <button
            popovertarget="menu"
            popovertargetaction="hide"
            class="mb-4 ml-auto block rounded-lg p-2 text-brand-950 lg:hidden"
            aria-label="Fechar menu"
          >
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
          <ul class="flex w-full flex-col gap-1 lg:flex-row lg:items-center lg:gap-0">
            {nav.map((item) => (
              <li class="relative">
                <a
                  href={item.href}
                  aria-current={current.startsWith(item.href) ? 'page' : undefined}
                  class="block rounded-lg px-3 py-2 font-display text-[15px] font-semibold text-brand-950 hover:text-brand-600 aria-[current=page]:text-brand-600"
                >
                  {item.label}
                </a>
                {item.sub.length > 0 && (
                  <ul class="sub mb-2 ml-3 border-l border-slate-200 pl-2 lg:m-0 lg:w-56 lg:rounded-xl lg:border lg:bg-white lg:p-2 lg:shadow-xl">
                    {item.sub.map((s) => (
                      <li>
                        <a
                          href={s.href}
                          class="block rounded-md px-3 py-1.5 text-sm hover:bg-brand-50 hover:text-brand-700"
                        >
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
            <li class="mt-4 lg:ml-3 lg:mt-0">
              <a href="/busca/" class="btn px-4 py-2 text-sm">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m20 20-3.5-3.5"></path>
                </svg>
                Buscar
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="bg-brand-950 text-brand-100">
      <div class="wrap grid gap-10 py-16 md:grid-cols-4">
        <div class="md:col-span-2">
          <p class="flex items-center gap-2 font-display text-xl font-bold text-white">
            <img src="/favicon.svg" alt="" width="32" height="32" /> Desbrave Chapecó
          </p>
          <p class="mt-3 max-w-sm text-brand-100/80">
            O guia para viver a Capital do Oeste: onde ficar, o que comer, o que fazer e o que está acontecendo.
          </p>
        </div>
        <div>
          <p class="font-display font-semibold text-white">Explore</p>
          <ul class="mt-3 space-y-2">
            {sectionKeys.map((k) => (
              <li>
                <a class="hover:text-white" href={`/${k}/`}>
                  {sections[k].label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-display font-semibold text-white">Planeje</p>
          <ul class="mt-3 space-y-2">
            <li>
              <a class="hover:text-white" href="/experiencias/">
                Rotas e experiências
              </a>
            </li>
            <li>
              <a class="hover:text-white" href="/eventos/">
                Agenda de eventos
              </a>
            </li>
            <li>
              <a class="hover:text-white" href="/sobre-chapeco/">
                Sobre Chapecó
              </a>
            </li>
            <li>
              <a class="hover:text-white" href="/sobre-chapeco/#como-chegar">
                Como chegar
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10">
        <p class="wrap py-6 text-sm text-brand-100/70">
          © {new Date().getFullYear()} Desbrave Chapecó. Todos os direitos reservados.
        </p>
      </div>
    </footer>
  </body>
</html>
