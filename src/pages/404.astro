---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <section class="wrap flex min-h-[60vh] flex-col items-start justify-center py-20">
    <p class="eyebrow">Erro 404</p>
    <h1 class="mt-2 font-display text-4xl font-bold text-brand-950 md:text-5xl">Ops, essa trilha não existe.</h1>
    <p class="mt-4 text-lg">A página que você procura mudou de endereço ou nunca existiu.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn">
        Voltar ao início
      </a>
      <a href="/busca/" class="btn-ghost text-brand-700">
        Buscar no site
      </a>
    </div>
  </section>
</Base>
