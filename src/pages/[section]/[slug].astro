---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { sections } from '../../site';
import { placeholder } from '../../placeholder';

export async function getStaticPaths() {
  const lugares = await getCollection('lugares');
  return lugares.map((entry) => ({
    params: { section: entry.data.section, slug: entry.id },
    props: {
      entry,
      related: lugares.filter((l) => l.data.section === entry.data.section && l.id !== entry.id).slice(0, 3),
    },
  }));
}

const { entry, related } = Astro.props;
const { name, section, category, summary, address, phone, site } = entry.data;
const s = sections[section];
const cats = s.categories as Record<string, string>;
const image = entry.data.image ?? placeholder(entry.id);
const og = (await getImage({ src: image, width: 1200, format: 'jpg' })).src;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': s.schemaType,
  name,
  description: summary,
  image: new URL(og, Astro.site).href,
  url: new URL(Astro.url.pathname, Astro.site).href,
  ...(address && {
    address: {
      '@type': 'PostalAddress',
      streetAddress: address,
      addressLocality: 'Chapecó',
      addressRegion: 'SC',
      addressCountry: 'BR',
    },
  }),
  ...(phone && { telephone: phone }),
};
---

<Base title={name} description={summary} image={og} jsonLd={jsonLd}>
  <article data-pagefind-body>
    <div class="wrap pt-8">
      <nav aria-label="Trilha" class="text-sm">
        <a href={`/${section}/`} class="text-brand-600 hover:underline">
          {s.label}
        </a>
        <span aria-hidden="true"> / </span>
        <a href={`/categoria/${section}/${category}/`} class="text-brand-600 hover:underline">
          {cats[category]}
        </a>
      </nav>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-950 md:text-5xl">{name}</h1>
      <p class="mt-3 max-w-2xl text-lg">{summary}</p>
      <Image
        src={image}
        alt=""
        width={1200}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-8 aspect-[2/1] w-full rounded-3xl object-cover"
      />
    </div>

    <div class="wrap grid gap-12 py-12 lg:grid-cols-3">
      <div class="prose-content space-y-4 text-lg lg:col-span-2">
        <Content />
      </div>
      {(address || phone || site) && (
        <aside class="h-fit rounded-3xl bg-brand-50 p-6" data-pagefind-ignore>
          <h2 class="font-display text-lg font-semibold text-brand-950">Informações</h2>
          <dl class="mt-4 space-y-3 text-sm">
            {address && (
              <div>
                <dt class="font-semibold text-brand-950">Endereço</dt>
                <dd>{address}, Chapecó/SC</dd>
              </div>
            )}
            {phone && (
              <div>
                <dt class="font-semibold text-brand-950">Telefone</dt>
                <dd>
                  <a class="text-brand-700 underline" href={`tel:${phone.replace(/\D/g, '')}`}>
                    {phone}
                  </a>
                </dd>
              </div>
            )}
            {site && (
              <div>
                <dt class="font-semibold text-brand-950">Site</dt>
                <dd>
                  <a class="text-brand-700 underline" href={site} rel="noopener" target="_blank">
                    {new URL(site).hostname}
                  </a>
                </dd>
              </div>
            )}
          </dl>
          {address && (
            <a
              class="btn mt-6 w-full justify-center"
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name}, ${address}, Chapecó SC`)}`}
              rel="noopener"
              target="_blank"
            >
              Ver no mapa
            </a>
          )}
        </aside>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="bg-slate-50 py-16">
      <div class="wrap">
        <h2 class="h2">Mais em {s.label}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((l) => (
            <Card
              href={`/${section}/${l.id}/`}
              title={l.data.name}
              image={l.data.image ?? placeholder(l.id)}
              eyebrow={cats[l.data.category]}
              text={l.data.summary}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
