---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Buscar" description="Pesquise hospedagens, restaurantes, atrativos, rotas e eventos em Chapecó.">
  <PageHeader eyebrow="Busca" title="O que você procura?" />
  <section class="wrap min-h-[50vh] pb-20">
    <!-- Pagefind index is generated by `npm run build`; it does not exist under `astro dev`. -->
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      const ui = new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
    </script>
  </section>
</Base>

<style is:global>
  #search {
    --pagefind-ui-primary: var(--color-brand-600);
    --pagefind-ui-border-radius: 1rem;
    --pagefind-ui-font: var(--font-sans);
  }
</style>
