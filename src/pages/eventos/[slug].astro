---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { eventCategories, dateBR } from '../../site';
import { placeholder } from '../../placeholder';

export async function getStaticPaths() {
  return (await getCollection('eventos')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, date, category, venue, summary } = entry.data;
const image = entry.data.image ?? placeholder(entry.id);
const og = (await getImage({ src: image, width: 1200, format: 'jpg' })).src;
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: summary,
  startDate: date.toISOString(),
  image: new URL(og, Astro.site).href,
  location: {
    '@type': 'Place',
    name: venue,
    address: { '@type': 'PostalAddress', addressLocality: 'Chapecó', addressRegion: 'SC', addressCountry: 'BR' },
  },
};
---

<Base title={title} description={summary} image={og} jsonLd={jsonLd}>
  <article data-pagefind-body>
    <div class="wrap pt-8">
      <a href={`/eventos/#${category}`} class="text-sm text-brand-600 hover:underline">
        Eventos · {eventCategories[category]}
      </a>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-950 md:text-5xl">{title}</h1>
      <p class="mt-3 text-lg">
        <time datetime={date.toISOString()} class="font-semibold text-brand-950">
          {dateBR(date)}
        </time>{' '}
        · {venue}
      </p>
      <Image
        src={image}
        alt=""
        width={1200}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-8 aspect-[2/1] w-full rounded-3xl object-cover"
      />
    </div>
    <div class="wrap prose-content max-w-3xl space-y-4 py-12 text-lg">
      <p>{summary}</p>
      <Content />
    </div>
  </article>
</Base>
