---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import PageHeader from '../../components/PageHeader.astro';
import { placeholder } from '../../placeholder';

const experiencias = (await getCollection('experiencias')).sort((a, b) => a.data.order - b.data.order);
const description = 'Rotas rurais e urbanas, turismo de negócios, esportivo e vida noturna em Chapecó.';
---

<Base title="Rotas e experiências" description={description}>
  <PageHeader eyebrow="Experiências" title="Rotas e experiências" text={description} />
  <section class="wrap pb-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {experiencias.map((x) => (
        <Card
          href={`/experiencias/${x.id}/`}
          title={x.data.title}
          image={x.data.image ?? placeholder(x.id)}
          text={x.data.summary}
        />
      ))}
    </div>
  </section>
</Base>
