---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { placeholder } from '../../placeholder';

export async function getStaticPaths() {
  return (await getCollection('experiencias')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, summary } = entry.data;
const image = entry.data.image ?? placeholder(entry.id);
const og = (await getImage({ src: image, width: 1200, format: 'jpg' })).src;
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: title,
  description: summary,
  image: new URL(og, Astro.site).href,
};
---

<Base title={title} description={summary} image={og} jsonLd={jsonLd}>
  <article data-pagefind-body>
    <div class="wrap pt-8">
      <a href="/experiencias/" class="text-sm text-brand-600 hover:underline">
        Rotas e experiências
      </a>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-brand-950 md:text-5xl">{title}</h1>
      <p class="mt-3 max-w-2xl text-lg">{summary}</p>
      <Image
        src={image}
        alt=""
        width={1200}
        widths={[600, 900, 1200]}
        sizes="(min-width: 1280px) 1216px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-8 aspect-[2/1] w-full rounded-3xl object-cover"
      />
    </div>
    <div class="wrap prose-content max-w-3xl space-y-4 py-12 text-lg">
      <Content />
    </div>
  </article>
</Base>
